PORT=3001
FRONTEND_URL=http://localhost:3000
ADDITIONAL_CORS_ORIGINS=
JSON_BODY_LIMIT=2mb
MAX_CONCURRENT_UPLOADS=3
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key
DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENROUTER_API_KEY=your-openrouter-key
RESEND_API_KEY=your-resend-key

# feat-024 — RAG over docs in a tabular review. text-embedding-3-small,
# 1536 dim. When unset, doc upload skips the embed-job enqueue and the
# TR chat falls back to cell-only context (no <retrieved_passage> blocks).
OPENAI_API_KEY=

# Set to "true" to enable POST /single-documents/embed-backfill, which
# enqueues an embed_document job for every accessible doc that has no
# chunks yet. Off by default so it can't fire accidentally on prod.
ENABLE_EMBED_BACKFILL=false

# Legal database search (feat-002). Federal Register and eCFR are open APIs
# (no auth). The other two need a free key:
#   CourtListener: https://www.courtlistener.com/help/api/rest/
#   GovInfo:       https://api.data.gov/signup/
# When unset, those sources return zero rows (warning logged) but the rest
# of legal_search continues to work.
COURTLISTENER_API_TOKEN=
GOVINFO_API_KEY=

# Web search (feat-003). Brave Search API. Free tier: 2K queries/month.
# Sign up: https://api.search.brave.com/
# When unset, the globe-icon toggle is still visible but enabling it has
# no effect — web_search returns zero rows with a warning logged.
BRAVE_SEARCH_API_KEY=

# Olava/Qwen generation controls. Qwen3 thinking mode is controlled through
# vLLM `chat_template_kwargs.enable_thinking`.
# - standard: preserve Qwen reasoning output (default in code when unset)
# - low/off: request non-thinking mode for stricter token/latency control
OLAVA_THINKING_MODE=standard
OLAVA_MAX_TOKENS=8192
OLAVA_COMPLETION_MAX_TOKENS=2048
